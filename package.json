{
  "name": "lingumaster-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "prebuild": "node scripts/check-badge.mjs && node scripts/generate-screens.mjs && node scripts/generate-og.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "postbuild": "node scripts/legal-canonical.mjs && node scripts/defer-runtime.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/register-ts.mjs --test src/lib/campaign.test.ts src/lib/analytics/analytics.test.ts src/content/draft-ribbon.test.ts src/content/legal/guards.test.ts src/content/legal/launch-gate.test.ts scripts/launch-gates.test.mjs",
    "analytics:mock": "node scripts/mock-collector.mjs",
    "check:badge": "node scripts/check-badge.mjs",
    "serve": "node scripts/serve.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "check:copy": "node scripts/diff-copy.mjs",
    "check:screens": "node scripts/guard-screens.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3"
  }
}
